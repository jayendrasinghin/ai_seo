{% comment %}
  Seoi JSON-LD schemas — Product, BreadcrumbList, Organization, WebSite.
  Enable via Theme settings → App embeds → Seoi Product JSON-LD.
{% endcomment %}

{%- if block.settings.enable_organization_schema -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ request.origin | json }}{% if settings.logo != blank %},
  "logo": {{ settings.logo | image_url: width: 512 | prepend: "https:" | json }}{% endif %}
}
</script>
{%- endif -%}

{%- if block.settings.enable_website_schema -%}
{%- assign seoi_search_placeholder = '{' | append: 'search_term_string' | append: '}' -%}
{%- assign seoi_search_target = request.origin | append: '/search?q=' | append: seoi_search_placeholder -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ request.origin | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {{ seoi_search_target | json }},
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  {%- if block.settings.enable_breadcrumb_schema -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ request.origin | json }}
      }{% if collection %},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ request.origin | append: collection.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ request.origin | append: product.url | json }}
      }
      {% else %},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ request.origin | append: product.url | json }}
      }
      {% endif %}
    ]
  }
  </script>
  {%- endif -%}

  {%- if block.settings.enable_product_schema -%}
  {%- assign seoi_variant = product.selected_or_first_available_variant -%}
  {%- assign seoi_price = seoi_variant.price | money_without_currency | replace: ',', '' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {% if product.featured_image %}
    "image": [
      {{ product.featured_image | image_url: width: 1200 | prepend: "https:" | json }}
      {%- for image in product.images limit: 4 -%}
        {%- unless forloop.first -%}
        , {{ image | image_url: width: 1200 | prepend: "https:" | json }}
        {%- endunless -%}
      {%- endfor -%}
    ],
    {% endif %}
    "description": {{ product.description | strip_html | truncate: 5000 | json }},
    {% if product.vendor != blank %}
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    {% endif %}
    {% if product.type != blank %}
    "category": {{ product.type | json }},
    {% endif %}
    {% if seoi_variant.sku != blank %}
    "sku": {{ seoi_variant.sku | json }},
    {% endif %}
    {% if seoi_variant.barcode != blank %}
    "gtin": {{ seoi_variant.barcode | json }},
    {% endif %}
    "offers": {
      "@type": "Offer",
      "url": {{ request.origin | append: product.url | json }},
      "priceCurrency": {{ shop.currency | json }},
      "price": {{ seoi_price | json }},
      "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition"
      {% if shop.name != blank %}
      ,"seller": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      }
      {% endif %}
    }
  }
  </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Product JSON-LD",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_product_schema",
      "label": "Product schema",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_breadcrumb_schema",
      "label": "BreadcrumbList schema",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_organization_schema",
      "label": "Organization schema",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_website_schema",
      "label": "WebSite + SearchAction schema",
      "default": true
    }
  ]
}
{% endschema %}
