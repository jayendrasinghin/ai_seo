generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}



model StoreUsage {
  id            String   @id @default(cuid())
  shop          String   @unique
  usedCredits   Int      @default(0)
  aiSeoUsed     Int      @default(0)
  aiImageUsed   Int      @default(0)
  freeQuotaLimit Int     @default(100)
  plan          String   @default("free")
  /// First-99 launch offer: Starter free for 12 months (not Pro / AI images).
  foundingMember       Boolean   @default(false)
  foundingMemberNumber Int?
  foundingGrantedAt    DateTime?
  foundingExpiresAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Cached Shopify shop profile (synced from Admin GraphQL for support admin).
model StoreProfile {
  id               String   @id @default(cuid())
  shop             String   @unique
  storeName        String?
  primaryDomain    String?
  /// Full public storefront URL (primaryDomain.url), e.g. https://example.com
  storefrontUrl    String?
  contactEmail     String?
  phone            String?
  address          String?
  country          String?
  timezone         String?
  currency         String?
  planDisplayName  String?
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Merchant low-stock email alerts (qty below threshold).
model InventoryAlertSettings {
  id            String   @id @default(cuid())
  shop          String   @unique
  alertEmail    String?
  alertsEnabled Boolean  @default(true)
  /// Notify when available quantity is below this value (exclusive).
  threshold     Int      @default(5)
  lastCheckedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Dedup record so the same location/item is not emailed repeatedly.
model LowStockNotification {
  id              String   @id @default(cuid())
  shop            String
  inventoryItemId String
  locationId      String
  productTitle    String?
  variantLabel    String?
  locationName    String?
  quantity        Int
  notifiedAt      DateTime @default(now())

  @@unique([shop, inventoryItemId, locationId])
  @@index([shop, notifiedAt])
}

/// One store-wide image SEO scan (paginate products in Day 3+).
model ImageScanRun {
  id              String   @id @default(cuid())
  shop            String
  /// pending | running | completed | failed
  status          String   @default("pending")
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  productsScanned Int      @default(0)
  imagesScanned   Int      @default(0)
  issuesOpen      Int      @default(0)
  errorMessage    String?

  issues ImageSeoIssue[]

  @@index([shop, startedAt(sort: Desc)])
}

/// Single image issue row from a scan (MISSING_ALT, SHORT_ALT, DUPLICATE_ALT).
model ImageSeoIssue {
  id           String       @id @default(cuid())
  shop         String
  scanRunId    String
  scanRun      ImageScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  productId    String
  productTitle String?
  /// Shopify MediaImage id (GID)
  mediaId      String
  imageUrl     String?
  currentAlt   String?
  suggestedAlt String?
  suggestionUpdatedAt DateTime?
  /// MISSING_ALT | SHORT_ALT | DUPLICATE_ALT
  issueType    String

  createdAt    DateTime @default(now())

  @@index([shop, scanRunId])
  @@index([shop, issueType])
  @@index([shop, productId])
}

/// Registered product / Shopify app shown in the support admin console.
model SupportApp {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages SupportMessage[]
}

/// Merchant support / contact form submissions (one row per message).
model SupportMessage {
  id            String   @id @default(cuid())
  shop          String
  /// Optional reply-to (merchant may leave blank).
  contactEmail  String?
  /// Optional WhatsApp number (international format, e.g. +91…).
  whatsapp      String?
  subject       String?
  message       String
  /// open | replied | closed
  status        String   @default("open")
  /// Which product app this ticket belongs to (nullable for legacy rows).
  appId         String?
  app           SupportApp? @relation(fields: [appId], references: [id], onDelete: SetNull)
  /// App owner reply (set via /admin); visible to the merchant on Help & support.
  reply         String?
  replyAt       DateTime?
  createdAt     DateTime @default(now())

  @@index([shop, createdAt(sort: Desc)])
  @@index([appId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AdminSession[]
  otpChallenges AdminOtpChallenge[]
}

model AdminSession {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash    String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([adminUserId, expiresAt])
}

/// Short-lived email OTP for admin login (after password check).
model AdminOtpChallenge {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  codeHash     String
  expiresAt    DateTime
  attempts     Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([adminUserId, expiresAt])
}

/// Per-shop SEO suite settings (IndexNow, sitemap, llms.txt, schema toggles).
model SeoSettings {
  id                 String   @id @default(cuid())
  shop               String   @unique
  indexNowEnabled    Boolean  @default(false)
  /// UUID-style key used for IndexNow submissions and key file.
  indexNowKey        String?
  /// Auto-submit IndexNow when products are created/updated.
  indexNowAutoPing   Boolean  @default(true)
  /// Publish HTML sitemap at /apps/seoi/sitemap
  sitemapEnabled     Boolean  @default(true)
  /// Publish llms.txt at /apps/seoi/llms.txt
  llmsTxtEnabled     Boolean  @default(true)
  /// Optional custom llms.txt body; blank = auto-generated from catalog.
  llmsTxtCustom      String?  @db.Text
  /// Theme embed JSON-LD recommended; store toggle for UI messaging.
  jsonLdEnabled      Boolean  @default(true)
  /// When a product is deleted, create a 301 from /products/{handle}.
  autoRedirectOnDelete Boolean @default(true)
  /// Target for auto-redirects (path or full URL). Default /collections/all
  autoRedirectTarget String   @default("/collections/all")
  /// Theme speed boost preferences (UI + guidance; embed does the work).
  lazyLoadEnabled      Boolean @default(true)
  assetPreloadEnabled  Boolean @default(true)
  scriptDeferEnabled   Boolean @default(true)
  /// Image optimizer defaults
  imageMaxWidth        Int     @default(2048)
  imageQuality         Int     @default(80)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Recent IndexNow submission log (for merchant visibility).
model IndexNowLog {
  id        String   @id @default(cuid())
  shop      String
  url       String
  status    String
  /// success | error
  message   String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt(sort: Desc)])
}

/// One broken-link / HTTP status crawl for a shop.
model LinkScanRun {
  id            String   @id @default(cuid())
  shop          String
  /// pending | running | completed | failed
  status        String   @default("pending")
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  urlsChecked   Int      @default(0)
  brokenCount   Int      @default(0)
  errorMessage  String?

  issues BrokenLinkIssue[]

  @@index([shop, startedAt(sort: Desc)])
}

/// A checked URL from a link scan (broken, error, or redirected).
model BrokenLinkIssue {
  id          String      @id @default(cuid())
  shop        String
  scanRunId   String
  scanRun     LinkScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  sourceType  String
  /// product | collection | page | other
  sourceId    String?
  sourceTitle String?
  sourceUrl   String?
  linkUrl     String
  /// broken | error | redirect | ok (ok usually not stored)
  status      String
  httpStatus  Int?
  finalUrl    String?
  /// When a redirect was created from this issue
  redirectCreated Boolean @default(false)

  createdAt   DateTime @default(now())

  @@index([shop, scanRunId])
  @@index([shop, status])
}

/// Log of auto 301s created when products were deleted.
model ProductDeleteRedirect {
  id        String   @id @default(cuid())
  shop      String
  handle    String
  path      String
  target    String
  createdAt DateTime @default(now())

  @@index([shop, createdAt(sort: Desc)])
}

/// Product image compression / resize job log.
model ImageOptimizeRun {
  id              String   @id @default(cuid())
  shop            String
  /// pending | running | completed | failed
  status          String   @default("pending")
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  imagesChecked   Int      @default(0)
  imagesOptimized Int      @default(0)
  bytesSaved      Int      @default(0)
  errorMessage    String?

  items ImageOptimizeItem[]

  @@index([shop, startedAt(sort: Desc)])
}

model ImageOptimizeItem {
  id            String           @id @default(cuid())
  shop          String
  runId         String
  run           ImageOptimizeRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  productId     String
  productTitle  String?
  mediaId       String
  originalUrl   String?
  originalBytes Int?
  newBytes      Int?
  /// optimized | skipped | error
  status        String
  message       String?
  createdAt     DateTime @default(now())

  @@index([shop, runId])
  @@index([shop, mediaId])
}

// ─── PaySync (PayPal tracking sync) ─────────────────────────────────────────

model Shop {
  id            String    @id @default(cuid())
  shopDomain    String    @unique
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paypalConnections   PayPalConnection[]
  razorpayConnections RazorpayConnection[]
  orderSyncs          OrderSync[]
  providerMappings    ProviderMapping[]
  webhookEvents       WebhookEvent[]
  settings            ShopSettings?
}

model ShopSettings {
  id                     String    @id @default(cuid())
  shopId                 String    @unique
  autoTaggingEnabled     Boolean   @default(true)
  notifyBuyerDefault     Boolean   @default(true)
  tagUnfulfilledPhysical Boolean   @default(true)
  dataRetentionDays      Int       @default(365)
  carrierMappings        Json      @default("{}")
  onboardingCompletedAt  DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

enum PayPalMode {
  SANDBOX
  LIVE
}

model PayPalConnection {
  id                    String     @id @default(cuid())
  shopId                String
  label                 String     @default("PayPal")
  isDefault             Boolean    @default(false)
  mode                  PayPalMode @default(SANDBOX)
  encryptedClientId     String
  encryptedClientSecret String
  connectedAt           DateTime   @default(now())
  lastValidatedAt       DateTime?
  lastValidationError   String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, isDefault])
}

model RazorpayConnection {
  id                  String    @id @default(cuid())
  shopId              String
  label               String    @default("Razorpay")
  isDefault           Boolean   @default(false)
  encryptedKeyId      String
  encryptedKeySecret  String
  connectedAt         DateTime  @default(now())
  lastValidatedAt     DateTime?
  lastValidationError String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([shopId, isDefault])
}

enum PaymentProvider {
  paypal
  shopify_payments
  stripe
  razorpay
  cashfree
  cod
  manual
  other
}

enum SyncStatus {
  pending
  queued
  retrying
  synced
  needs_mapping
  not_applicable
  failed_permanent
  failed
}

enum MappingSource {
  AUTO
  MANUAL
  IMPORT
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed
  duplicate
}

model OrderSync {
  id                String          @id @default(cuid())
  shopId            String
  shopifyOrderGid   String
  shopifyOrderName  String
  shopifyCreatedAt  DateTime?
  customerName      String?
  itemsSummary      String?
  paymentProvider   PaymentProvider
  paymentStatus     String
  providerOrderId   String?
  providerCaptureId String?
  fulfillmentStatus String          @default("unfulfilled")
  trackingStatus    String          @default("none")
  syncStatus        SyncStatus      @default(pending)
  lastError         String?
  lastSyncedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shipments ShipmentSync[]

  @@unique([shopId, shopifyOrderGid])
  @@index([shopId, syncStatus])
  @@index([shopId, paymentProvider])
  @@index([updatedAt])
  @@index([shopifyCreatedAt])
}

model ShipmentSync {
  id                    String     @id @default(cuid())
  orderSyncId           String
  shopifyFulfillmentGid String?
  trackingNumber        String
  carrier               String
  carrierRaw            String?
  shipmentStatus        String     @default("pending")
  paypalTrackerId       String?
  syncStatus            SyncStatus @default(pending)
  retryCount            Int        @default(0)
  nextRetryAt           DateTime?
  lastError             String?
  syncedAt              DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  orderSync    OrderSync     @relation(fields: [orderSyncId], references: [id], onDelete: Cascade)
  syncAttempts SyncAttempt[]

  @@unique([orderSyncId, trackingNumber])
  @@index([syncStatus, nextRetryAt])
}

model ProviderMapping {
  id              String          @id @default(cuid())
  shopId          String
  shopifyOrderGid String
  provider        PaymentProvider
  providerOrderId String
  mappingSource   MappingSource   @default(AUTO)
  mappedBy        String?
  verifiedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyOrderGid, provider])
}

model WebhookEvent {
  id          String             @id @default(cuid())
  shopId      String?
  topic       String
  webhookId   String?
  payloadHash String
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  status      WebhookEventStatus @default(received)
  error       String?

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@unique([topic, payloadHash])
  @@index([status, receivedAt])
}

model SyncAttempt {
  id              String   @id @default(cuid())
  shipmentSyncId  String
  provider        String
  requestSummary  Json
  responseStatus  Int?
  responseSummary Json?
  errorCode       String?
  errorMessage    String?
  correlationId   String?
  createdAt       DateTime @default(now())

  shipmentSync ShipmentSync @relation(fields: [shipmentSyncId], references: [id], onDelete: Cascade)

  @@index([shipmentSyncId, createdAt])
}